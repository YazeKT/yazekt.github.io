---
interface Props { slug: string; data: any; index: number; }
const { slug, data, index } = Astro.props;
---
<article class="project-card">
  <a class="project-card__art" href={`/work/${slug}/`} aria-label={`Read the ${data.title} case study`}>
    <img src={data.art} srcset={`${data.art.replace('.webp', '-800.webp')} 800w, ${data.art.replace('.webp', '-1600.webp')} 1600w, ${data.art} 3840w`} sizes="(max-width: 900px) 100vw, 63vw" alt={data.artAlt} width="3840" height="2160" loading="lazy" />
  </a>
  <span class="art-label">Conceptual artwork</span>
  <div class="project-card__copy">
    <p class="mono">{String(index).padStart(2, '0')} · {data.platform}</p>
    <h2><a href={`/work/${slug}/`}>{data.title}</a></h2>
    <p>{data.summary}</p>
    <div class="project-card__screen screen-frame">
      <img src={data.hero} alt={data.heroAlt} width={data.heroWidth} height={data.heroHeight} loading="lazy" />
    </div>
    <a class="text-link" href={`/work/${slug}/`}>Open the case study <span aria-hidden="true">↗</span></a>
  </div>
</article>
