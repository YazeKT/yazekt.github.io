---
interface Props { pageName: string; }
const { pageName } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/#process', label: 'Process' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/about/', label: 'About' },
  { href: '/resume/', label: 'Resume' },
  { href: '/#contact', label: 'Contact' }
];
const active = (href: string) => href.endsWith('/') && path.startsWith(href);
---
<header class="site-header" data-theme="dark">
  <a class="brand-lockup" href="/" aria-label="Yaze Media home">
    <img src="/favicon.svg" width="34" height="34" alt="" />
    <span>Yaze Media</span>
  </a>
  <p class="header-page">{pageName}</p>
  <nav aria-label="Main navigation">
    {links.map((link) => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>
