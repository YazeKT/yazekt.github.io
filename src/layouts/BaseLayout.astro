---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageName?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = site.title,
  description = site.description,
  image = '/images/social-card.png',
  pageName = 'Index',
  schema
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);
const defaultSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    founder: { '@type': 'Person', name: site.creator }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.creator,
    url: `${site.url}/about/`,
    jobTitle: 'AI product developer',
    email: `mailto:${site.email}`,
    sameAs: [site.github]
  }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F3EFE7" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="author" content={site.creator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Yaze Media — Practical AI products, designed and shipped" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema ?? defaultSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header pageName={pageName} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
