---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { roles, site } from '../data/site';
const entries = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
---
<BaseLayout pageName="Home" preloadImage="/images/art/workshop-hero-800.webp">
  <section class="workshop-hero">
    <div class="workshop-hero__copy">
      <p class="mono hero-index">Yaze Media / Product practice / 2026</p>
      <h1>AI-assisted products,<br /><em>shaped by human judgment.</em></h1>
      <p class="hero-deck">Designed and shipped by Kirsten Trimaley. Practical Windows and web products built from real workflow problems, careful product decisions, and proof that can be inspected.</p>
      <div class="hero-actions"><a class="button" href="#selected-work">View the work <span aria-hidden="true">↓</span></a><a class="button button-dark" href={`mailto:${site.email}?subject=Remote%20opportunity%20for%20Kirsten%20Trimaley`}>Discuss a remote role</a></div>
    </div>
    <div class="workshop-hero__proof"><p>About ten years of visual judgment</p><p>4 documented product stories</p><p>East London → Remote</p></div>
  </section>
  <section class="atlas-intro page-shell" id="selected-work">
    <div><p class="mono">The Yaze Product Atlas</p><h2>Four products.<br />One flowing practice.</h2></div>
    <p>Each world begins with a messy operator problem. Follow the cobalt current through the decisions, the real interface, and the evidence behind what shipped.</p>
  </section>
  <figure class="atlas-art page-shell"><img src="/images/art/homepage-product-atlas.webp" srcset="/images/art/homepage-product-atlas-800.webp 800w, /images/art/homepage-product-atlas-1600.webp 1600w, /images/art/homepage-product-atlas.webp 3840w" sizes="100vw" alt="A carved-paper product atlas connected by a luminous cobalt river, representing four distinct Yaze Media product worlds" width="3840" height="2160" loading="lazy" /><figcaption>Illustrative product atlas — conceptual artwork, not a software interface.</figcaption></figure>
  <section class="page-shell product-flow" aria-label="Featured product case studies">{entries.map((entry, index) => <ProjectCard slug={entry.id} data={entry.data} index={index + 1} />)}</section>
  <section class="process-section page-shell" id="process">
    <div class="process-statement"><p class="mono">How I work</p><h2>AI accelerates the work.<br /><em>I remain accountable.</em></h2></div>
    <ol class="process-list">
      <li><span>01</span><strong>Understand</strong><p>Start with the operator, the environment, and the real cost of failure.</p></li>
      <li><span>02</span><strong>Shape</strong><p>Turn the workflow into a clear product boundary and a deliberate interface.</p></li>
      <li><span>03</span><strong>Build</strong><p>Direct AI coding agents, inspect the output, and protect proven foundations.</p></li>
      <li><span>04</span><strong>Verify</strong><p>Test the actual package, routes, files, privacy boundary, and public claim.</p></li>
      <li><span>05</span><strong>Ship</strong><p>Publish the useful version with evidence, documentation, and ownership.</p></li>
    </ol>
    <p class="accountability">I use AI to explore and accelerate, but I own the product decisions, the verification, and the responsibility for what ships.</p>
  </section>
  <section class="roadmap-tease page-shell">
    <div><p class="mono">The work continues</p><h2>Building the next useful things.</h2><p>Archiva and AI News Studio are active workshops — shown as intentions and current progress, never as finished claims.</p><a class="button" href="/roadmap/">See the roadmap <span aria-hidden="true">↗</span></a></div>
    <img src="/images/art/roadmap-river-horizon.webp" srcset="/images/art/roadmap-river-horizon-800.webp 800w, /images/art/roadmap-river-horizon-1600.webp 1600w, /images/art/roadmap-river-horizon.webp 3840w" sizes="(max-width: 900px) 100vw, 63vw" alt="A cobalt river approaches two workshop islands representing careful archiving and responsible media production" width="3840" height="2160" loading="lazy" />
  </section>
  <section class="availability-strip page-shell" aria-label="Role availability">{roles.slice(0, 3).map((role) => <p>{role}</p>)}<p>Available for remote work</p></section>
</BaseLayout>
